# --- YALNIZCA GELİŞTİRME -------------------------------------------------------------
# Paketlenmiş uygulamada anahtarlar Kurulum Sihirbazı'na girilir ve işletim sistemi anahtarlığıyla
# korunan şifreli depoda saklanır. Bu dosya yalnızca `npm run dev` için bir kolaylıktır ve
# GitHub'a GÖNDERİLMEZ (.gitignore).

# Google Cloud: Places API (New) anahtarı. Yalnızca "Places API (New)" ile kısıtlayın ve günlük kota koyun.
GOOGLE_PLACES_API_KEY=
# Google Cloud: Maps JavaScript API tarayıcı anahtarı
GOOGLE_MAPS_BROWSER_KEY=

# Veri klasörü (varsayılan: ./.data). Başka bir diske yönlendirmek için:
# UM_DATA_DIR=/Volumes/SanDisk/um-data

# --- Sonraki fazlar (şimdilik kullanılmıyor) -----------------------------------------
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# HUNTER_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# INSEE_SIRENE_API_KEY=
# ANTHROPIC_API_KEY=
