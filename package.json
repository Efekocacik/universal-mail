{
  "name": "universal-mail",
  "version": "0.1.0",
  "private": true,
  "description": "Yeni açılan işletmeleri bulan ve kontrollü B2B e-posta gönderen yerel masaüstü aracı",
  "author": "Kerim Efe Kocacık",
  "license": "UNLICENSED",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run db:migrate -- --wipe-session && concurrently -k -n web,worker -c blue,green \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:worker": "tsx watch --clear-screen=false src/worker/index.ts",
    "build": "npm run build:web && npm run build:bundles && npm run build:standalone",
    "build:web": "next build",
    "build:bundles": "node scripts/build-bundles.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "cities:build": "node scripts/build-cities.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "npm run build:bundles && UM_DEV_URL=http://127.0.0.1:3000 electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "build:standalone": "node scripts/prepare-standalone.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "bench": "tsx scripts/bench.mts"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "@vitest/coverage-v8": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "lucide-react": "^1.59.0",
    "next": "^15.5.28",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "homepage": "https://github.com/Efekocacik/universal-mail",
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    }
  }
}
